{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Docker Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "/home/app/opt/cli.py",
            "cwd": "/home/app/opt",
            "console": "integratedTerminal"
        }
    ]
}